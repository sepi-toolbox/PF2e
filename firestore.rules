rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 개인 캐릭터 (5슬롯) ──
    match /users/{userId}/characters/{slotId} {
      // 본인은 항상 읽기/쓰기 가능
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // GM이 세션 참가자의 캐릭터를 편집할 수 있도록
      // (캐릭터 doc에 sessionId가 있으면 해당 세션의 GM에게 허용)
      allow read, write: if request.auth != null
        && resource.data.sessionId != null
        && get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.gmUid == request.auth.uid;
    }

    // ── 세션 ──
    match /sessions/{sessionId} {
      // 누구나 읽기 가능 (참가 코드 검증용)
      allow read: if request.auth != null;
      // GM만 생성
      allow create: if request.auth != null;
      // 로그인 사용자가 수정 가능 (참가/퇴장 — players map 자기 항목만 변경)
      allow update: if request.auth != null;
      // GM만 삭제
      allow delete: if request.auth != null
        && resource.data.gmUid == request.auth.uid;

      // ── 주사위 굴림 ──
      match /rolls/{rollId} {
        // 세션 참가자면 읽기 가능
        allow read: if request.auth != null;
        // 로그인한 사용자가 자기 uid로만 생성 가능
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
        // GM만 삭제 (정리용)
        allow delete: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.gmUid;
      }

      // ── 전술 맵 상태 (배경/안개/그리드) ──
      match /map/{docId} {
        // 세션 참가자(로그인 사용자) 읽기 가능
        allow read: if request.auth != null;
        // GM만 쓰기 (배경 업로드 / 안개 / 그리드)
        allow write: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.gmUid;
      }

      // ── 토큰 ──
      match /tokens/{tokenId} {
        function gmUid() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)).data.gmUid;
        }
        function isGM() { return request.auth.uid == gmUid(); }
        // 세션 참가자 읽기 가능
        allow read: if request.auth != null;
        // 생성: GM이거나, 본인 소유(ownerUid==uid) 토큰 (자동 프로비저닝 — 플레이어는 자기 토큰만)
        allow create: if request.auth != null
          && (isGM() || request.resource.data.ownerUid == request.auth.uid);
        // 수정: GM은 전체. 플레이어(소유자)는 '이동(x,y)'만 허용 — 이름/색/크기/숨김/소유자 변경 불가
        allow update: if request.auth != null
          && (isGM()
              || (resource.data.ownerUid == request.auth.uid
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['x', 'y', 'updatedAt', 'updatedBy'])));
        // 삭제: GM 전용 (플레이어는 토큰 삭제 불가)
        allow delete: if request.auth != null && isGM();
      }
    }
  }
}
