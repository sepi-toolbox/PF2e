rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // GM 소유자(bsg9072@gmail.com) — GM은 이 계정만. uid 기준(불변·위조불가).
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'D11melTRb6VFObMbKvkP4t3Flgv2';
    }

    // ── 버그 제보 (로그인 사용자 생성 / 소유자만 열람·관리) ──
    match /bug_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isOwner();
    }

    // ════════════════════════ 운영(prod) ════════════════════════

    // ── 개인 캐릭터 (5슬롯) ──
    match /users/{userId}/characters/{slotId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if request.auth != null
        && resource.data.sessionId != null
        && get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.gmUid == request.auth.uid;
    }

    // ── 세션 ──
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if isOwner() && request.resource.data.gmUid == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.gmUid == resource.data.gmUid;
      allow delete: if isOwner() && resource.data.gmUid == request.auth.uid;

      match /rolls/{rollId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.gmUid;
      }
      match /maps/{mapId} {
        function gmUid() { return get(/databases/$(database)/documents/sessions/$(sessionId)).data.gmUid; }
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == gmUid();
        match /tokens/{tokenId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null
            && (request.resource.data.ownerUid == request.auth.uid || request.auth.uid == gmUid());
          allow update: if request.auth != null;
          allow delete: if request.auth != null && request.auth.uid == gmUid();
        }
        // AoE 영역 템플릿 — 읽기=참가자, 쓰기=GM
        match /areas/{areaId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == gmUid();
        }
      }
      match /pings/{pingId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null;
      }
      match /tokenTemplates/{tid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.gmUid;
      }
    }

    // ════════════════════════ 데브(dev) ════════════════════════
    // /dev/ 빌드 전용 — 운영과 데이터 격리. 규칙은 운영과 동일, 경로만 *_dev.

    // ── 데브 개인 캐릭터 ──
    match /users/{userId}/characters_dev/{slotId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if request.auth != null
        && resource.data.sessionId != null
        && get(/databases/$(database)/documents/sessions_dev/$(resource.data.sessionId)).data.gmUid == request.auth.uid;
    }

    // ── 데브 세션 ──
    match /sessions_dev/{sessionId} {
      allow read: if request.auth != null;
      allow create: if isOwner() && request.resource.data.gmUid == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.gmUid == resource.data.gmUid;
      allow delete: if isOwner() && resource.data.gmUid == request.auth.uid;

      match /rolls/{rollId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/sessions_dev/$(sessionId)).data.gmUid;
      }
      match /maps/{mapId} {
        function gmUid() { return get(/databases/$(database)/documents/sessions_dev/$(sessionId)).data.gmUid; }
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == gmUid();
        match /tokens/{tokenId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null
            && (request.resource.data.ownerUid == request.auth.uid || request.auth.uid == gmUid());
          allow update: if request.auth != null;
          allow delete: if request.auth != null && request.auth.uid == gmUid();
        }
        // AoE 영역 템플릿 — 읽기=참가자, 쓰기=GM
        match /areas/{areaId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == gmUid();
        }
      }
      match /pings/{pingId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null;
      }
      match /tokenTemplates/{tid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/sessions_dev/$(sessionId)).data.gmUid;
      }
    }
  }
}
