rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 개인 캐릭터 (5슬롯) ──
    match /users/{userId}/characters/{slotId} {
      // 본인은 항상 읽기/쓰기 가능
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // GM이 세션 참가자의 캐릭터를 편집할 수 있도록
      // (캐릭터 doc에 sessionId가 있으면 해당 세션의 GM에게 허용)
      allow read, write: if request.auth != null
        && resource.data.sessionId != null
        && get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.gmUid == request.auth.uid;
    }

    // ── 세션 ──
    match /sessions/{sessionId} {
      // 누구나 읽기 가능 (참가 코드 검증용)
      allow read: if request.auth != null;
      // GM만 생성
      allow create: if request.auth != null;
      // 로그인 사용자가 수정 가능 (참가/퇴장 — players map 자기 항목만 변경)
      allow update: if request.auth != null;
      // GM만 삭제
      allow delete: if request.auth != null
        && resource.data.gmUid == request.auth.uid;

      // ── 주사위 굴림 ──
      match /rolls/{rollId} {
        // 세션 참가자면 읽기 가능
        allow read: if request.auth != null;
        // 로그인한 사용자가 자기 uid로만 생성 가능
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
        // GM만 삭제 (정리용)
        allow delete: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.gmUid;
      }

      // ── 전술 맵 상태 (배경/안개/그리드) ──
      match /map/{docId} {
        // 세션 참가자(로그인 사용자) 읽기 가능
        allow read: if request.auth != null;
        // GM만 쓰기 (배경 업로드 / 안개 / 그리드)
        allow write: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.gmUid;
      }

      // ── 토큰 ──
      // 정책: 이동은 모두에게(누구나 어떤 토큰이든 이동). 임의 추가/삭제는 비활성(지도엔 추가/편집/삭제 UI 없음).
      match /tokens/{tokenId} {
        function gmUid() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)).data.gmUid;
        }
        // 세션 참가자 읽기
        allow read: if request.auth != null;
        // 생성: 자기 소유 토큰만 (입장 시 자동 프로비저닝 — 임의 추가 UI는 없음)
        allow create: if request.auth != null
          && request.resource.data.ownerUid == request.auth.uid;
        // 수정(이동): 세션 참가자 모두 (초상 동기화 포함)
        allow update: if request.auth != null;
        // 삭제: GM 전용 (지도엔 삭제 UI 없음 — 세션 정리용)
        allow delete: if request.auth != null && request.auth.uid == gmUid();
      }

      // ── 핑 (롱프레스 일시 마커) ──
      match /pings/{pingId} {
        allow read: if request.auth != null;                                  // 세션 참가자 모두
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid;                   // 자기 uid로만 생성
        allow delete: if request.auth != null;                                // 작성자 자동삭제(5초) — 참가자 누구나 정리 허용
      }
    }
  }
}
