0Fszv","fGdHkWCD2CrB0Pot","sKmHwzlv4UfZs7CS","6H89y4nwsrC7o3X5","YGcSWGHQ23i4cezW","Y3O7AOvH1wkpSV2Z","1qBTVbPZxVREvpnT","UGFoKIvbXM0ZSdiU","Kv1pkf5Ma30A8n58"],"name":"Vlorian Cythnigot","system":{"abilities":{"cha":{"mod":1},"con":{"mod":4},"dex":{"mod":3},"int":{"mod":2},"str":{"mod":2},"wis":{"mod":2}},"attributes":{"ac":{"details":"","value":19},"allSaves":{"value":""},"hp":{"details":"","max":45,"temp":0,"value":45},"immunities":[{"type":"controlled"},{"type":"fear-effects"}],"resistances":[{"type":"mental","value":3},{"exceptions":["cold-iron"],"type":"physical","value":3}],"speed":{"otherSpeeds":[],"value":30},"weaknesses":[]},"details":{"blurb":"Variant cythnigot","languages":{"details":"telepathy (touch only)","value":["chthonian"]},"level":{"value":3},"privateNotes":"","publicNotes":"<p>The cythnigot is a foul fungal parasite that grows and thrives in the corpses of small creatures. It wears these bodies like a suit, but also adjusts and tailors the fleshy covering to suit its needs, and the body ends up looking as alien as anything else spawned from the Abyssal depths. The cythnigot's most identifying feature is the long stalk of fungal material that extends from creature's body, ending in a surprisingly strong set of fanged jaws.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Adventure: Rusthenge"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":9,"senses":[{"type":"darkvision"}]},"resources":{"focus":{"max":1,"value":1}},"saves":{"fortitude":{"saveDetail":"","value":11},"reflex":{"saveDetail":"","value":7},"will":{"saveDetail":"","value":9}},"skills":{"acrobatics":{"base":9},"athletics":{"base":9},"occultism":{"base":9},"stealth":{"base":9}},"traits":{"rarity":"rare","size":{"value":"med"},"value":["chaotic","evil","fiend","qlippoth","unholy"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","effects":[]},{"_id":"otBXbd41vVLZW1xv","img":"systems/pf2e/icons/default-icons/npc.svg","items":["HWXuHVykPjfsTiYH","XsoviG4MphXHKUIa","d1cyC0vptbTtXFE2","Wo73VHAjF7M37ttK","6kZm8XnYELAQFppU","lnftcCa5nWLimB4r","EhuGQeaf8C8WswTy","v88O0NAy45VWmtTO","N6z6E7Ly3t7eFBoU"],"name":"Starving Werebat","prototypeToken":{"name":"Werebat"},"system":{"abilities":{"cha":{"mod":0},"con":{"mod":3},"dex":{"mod":4},"int":{"mod":1},"str":{"mod":2},"wis":{"mod":3}},"attributes":{"ac":{"details":"","value":18},"adjustment":"weak","allSaves":{"value":""},"hp":{"details":"","max":35,"temp":0,"value":25},"speed":{"otherSpeeds":[],"value":25},"weaknesses":[{"type":"silver","value":5}]},"details":{"blurb":"Weak svirfneblin werebat","languages":{"details":"bat empathy","value":["common"]},"level":{"value":2},"privateNotes":"","publicNotes":"<p>Werebats form organized colonies of opportunistic hunters. They aren't shy about transforming creatures to add to their colony, whom they initiate with elaborate social ceremonies and bloody hazing. The curse of the werebat gives them a strong urge to prey upon on weaker, lonely creatures. True werebats are often unusually tall and thin, with angular features. In combat, werebats favor their unarmed attacks because they can't fly while wielding weapons in their wings.</p>\n<hr />\n<p>Werecreatures are humanoids who transform into animals and animal-humanoid hybrids under the light of the full moon. The fate of these shapechanging creatures derives from an ancient primal curse that they can, in turn, transmit through their own bites. The stat blocks in this section reflect werecreatures in their hybrid forms.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Adventure: Rusthenge"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":8,"senses":[{"type":"low-light-vision"},{"acuity":"imprecise","range":30,"type":"scent"}]},"resources":{},"saves":{"fortitude":{"saveDetail":"","value":9},"reflex":{"saveDetail":"","value":10},"will":{"saveDetail":"","value":7}},"skills":{"acrobatics":{"base":8},"athletics":{"base":6},"deception":{"base":4},"society":{"base":5},"stealth":{"base":8}},"traits":{"rarity":"common","size":{"value":"sm"},"value":["beast","evil","gnome","humanoid","werecreature"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","effects":[]},{"_id":"romVSuOVkSVFwsN4","img":"systems/pf2e/icons/default-icons/npc.svg","items":["60deOo2mPqEopbvy","0uP0B0abMW2C3oCF","OjsWQRj3OIwjDeSY","Ob1Whq4XKznU5eqm","XJH7nyTSPGl6Jlei","4XEEsDmNblamB0M7","39ZLNGk94E2Ntipj","emLL1emgN1gOgcV7","8zVcKcO19xk93UXt","Wz63TgYADlZxkXwy","LNRtNrzHIseTefIq","WQOlDXTuTi9ft8ls","edVyMro5viX5rgD9","fH4zN6EufktPqbW4","pyDc4hD647pfgYEk","IvUr6AnOtG8K2BSD"],"name":"Clockwork Belimarius","system":{"abilities":{"cha":{"mod":-5},"con":{"mod":3},"dex":{"mod":4},"int":{"mod":-5},"str":{"mod":2},"wis":{"mod":2}},"attributes":{"ac":{"details":"","value":20},"allSaves":{"value":""},"hp":{"details":"","max":45,"temp":0,"value":45},"immunities":[],"resistances":[{"doubleVs":[],"exceptions":["adamantine","bludgeoning","orichalcum"],"type":"physical","value":5}],"speed":{"otherSpeeds":[],"value":25},"weaknesses":[{"exceptions":[],"type":"electricity","value":5},{"exceptions":[],"type":"orichalcum","value":5}]},"details":{"blurb":"Variant clockwork mage","languages":{"details":"","value":[]},"level":{"value":4},"privateNotes":"","publicNotes":"<p>A clockwork mage is a lethal blend of magic and machinery. Each of these clockworks is imbued with an arcane stone at its core that powers spells through the wand embedded in its chest.</p>\n<hr />\n<p>Intricate, complex machines, clockworks are built with care by highly skilled engineers. Though their creation involves some amount of magic, they're primarily mechanical, packed with precision-tuned gears and springs working in concert.</p>\n<p>The sturdy mainspring within a clockwork must be wound to provide the energy needed to power the device. Some larger clockworks contain a series of springs for different limbs that each need to be wound. A clockwork's crafter creates a unique metal key while building the clockwork; winding the clockwork usually involves inserting the key into the machine's back and turning clockwise. Larger clockworks require greater strength to turn the key, and typically have larger keys to allow for more torque-some even accommodating a team of winders rather than an individual. Programming a clockwork requires both the key and the knowledge to set the program correctly, information usually reserved for the clockwork's creator or owner.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Adventure: Rusthenge"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":10,"senses":[{"type":"darkvision"}]},"resources":{"focus":{"max":1,"value":1}},"saves":{"fortitude":{"saveDetail":"","value":11},"reflex":{"saveDetail":"","value":12},"will":{"saveDetail":"","value":8}},"skills":{"acrobatics":{"base":12}},"traits":{"rarity":"unique","size":{"value":"med"},"value":["clockwork","construct","mindless"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","effects":[]},{"_id":"vQeUoEfY80yBs0Bb","img":"systems/pf2e/icons/default-icons/npc.svg","items":["YuejnaqH1UUSFEtm","bKldotvWkspZfjHv","sMARhZT9LlEbyj9A","TAYmc59V4sXfSfw5","HkdEGyFCz3KJQDFe","TuM7xwEDIHACG7NZ","C2rsbTOD3F9y6irF","0XoylDkAv1amxtQB","OmcfUYyCkGRjSKmB","cIbdrH5jcFj8t5ik","p8EZCiPuYDGVa8gR","Va0XfogT4F60cFwg","VQBSvBNauoUtz1yW","qfUlje8uIZvyiwdl","Gw1aL6nvi3vctrVz","rlUeL3r4Q1tTG2zt","p7M7UC9dplhPVlfb","zXqiG5p6MwIqhfOo","T5RTOEKfn1xH57j3","7IjR4hMNtoS1jTfK","ghVPWzR0nSUyYXOz","6N6oDDqKb0CaILEx","saoVl2MlopNbuTo8","qtsF75k2Zterahrt","36QKwrAooz1cygR4"],"name":"Zaiox","system":{"abilities":{"cha":{"mod":4},"con":{"mod":2},"dex":{"mod":3},"int":{"mod":3},"str":{"mod":1},"wis":{"mod":-1}},"attributes":{"ac":{"details":"","value":21},"allSaves":{"value":""},"hp":{"details":"","max":50,"temp":0,"value":50},"immunities":[{"exceptions":[],"type":"confused"}],"speed":{"otherSpeeds":[],"value":20},"weaknesses":[{"type":"vulnerable-to-sunlight","value":0}]},"details":{"blurb":"Variant male dero magister","languages":{"details":"","value":["aklo","sakvroth"]},"level":{"value":4},"privateNotes":"","publicNotes":"<p>Dero magisters are leaders among dero society. They perform the bulk of the cruel operations and memory-altering procedures inflicted upon their victims.</p>\n<hr />\n<p>Deros are short, wiry humanoids with milky white eyes, gray-blue skin, and wild shocks of off-white or gray hair. The descendants of a mysterious type of fey abandoned in the deepest, darkest caverns of Golarion, deros are the subject of fearful legends and folk tales to most of the world's surface races. They skulk beneath major metropolitan areas, performing cruel and twisted experiments on unwilling subjects. A dero is 3 feet tall and weighs approximately 70 pounds.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Adventure: Rusthenge"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":7,"senses":[{"type":"darkvision"}]},"resources":{"focus":{"max":1,"value":1}},"saves":{"fortitude":{"saveDetail":"","value":8},"reflex":{"saveDetail":"","value":11},"will":{"saveDetail":"","value":7}},"skills":{"crafting":{"base":9},"intimidation":{"base":12},"occultism":{"base":11},"stealth":{"base":11}},"traits":{"rarity":"unique","size":{"value":"sm"},"value":["chaotic","dero","evil","humanoid"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","effects":[]},{"_id":"ye8Niis34NfY30TS","img":"systems/pf2e/icons/default-icons/npc.svg","items":["byGy8WeeprOm4nwb","kiCT3SIcgPIBLg7h","favrQlUoHErC3KCl","v3LmIBb4HQpiKDtg","j1LalS1XgANCE491","5rZgScmhTb2oHDi5","yCN5vbIFoFQOtwDD","fz35P7gsZdhhCdXJ","AIJf0XcwzexNFxqt","PlbmKaRX84OVd7BY","QNrJiFnDAcAf1EEx","JR9rDE3OjVCSZCgv","C7rt9frNIOpSJ6FG","0rb0FqsjNt2Nyk86","kmzXulF3eDFPKBbJ","pX5ZVU58hBa0MsKY","G9G16E2ytvArWDU1","htliQ05jVKwfE22v","UDhWMhJzdEJtykvO"],"name":"Ordwi","system":{"abilities":{"cha":{"mod":3},"con":{"mod":2},"dex":{"mod":0},"int":{"mod":1},"str":{"mod":0},"wis":{"mod":4}},"attributes":{"ac":{"details":"","value":12},"allSaves":{"value":""},"hp":{"details":"","max":30,"temp":0,"value":30},"speed":{"otherSpeeds":[],"value":25}},"details":{"blurb":"Female human cleric of Cayden Cailean","languages":{"details":"","value":["common","thassilonian","varisian"]},"level":{"value":2},"privateNotes":"","publicNotes":"","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Adventure: Rusthenge"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":8,"senses":[]},"resources":{"focus":{"max":1,"value":1}},"saves":{"fortitude":{"saveDetail":"","value":6},"reflex":{"saveDetail":"","value":4},"will":{"saveDetail":"","value":10}},"skills":{"athletics":{"base":4},"crafting":{"base":5},"diplomacy":{"base":7},"religion":{"base":8},"society":{"base":5}},"traits":{"rarity":"unique","size":{"value":"med"},"value":["chaotic","good","human","humanoid"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","effects":[]},{"_id":"yscVNbJvyotk9NLG","img":"systems/pf2e/icons/default-icons/npc.svg","items":["gOiaDjo5WK8ESJHN","kXNpZJNwP0OyD0ds","JMVuOemee69jwYP3","ugATBRw6Dd80sfYi","uDh9HYtI9AukuNOk","oQ1wQPUo6g2iysB1","wncZzBRw5mBr1I3b","krTijhbyuSJ6RpE4","EbsFN4gbz3zpDwft","p6uToNU7wgFDgDDH","Lb8baU3vfeAtn1Nw","h8caQJMnKj4F22zZ","xdQJFj57QglkQXeG"],"name":"Dretch","system":{"abilities":{"cha":{"mod":0},"con":{"mod":4},"dex":{"mod":0},"int":{"mod":-3},"str":{"mod":3},"wis":{"mod":0}},"attributes":{"ac":{"details":"","value":17},"allSaves":{"value":""},"hp":{"details":"","max":45,"temp":0,"value":45},"speed":{"otherSpeeds":[],"value":20},"weaknesses":[{"type":"cold-iron","value":3},{"type":"holy","value":3}]},"details":{"blurb":"","languages":{"details":"telepathy 100 feet","value":["chthonian"]},"level":{"value":2},"privateNotes":"","publicNotes":"<p>Among the lowest and least powerful of all demons, dretches are just as vicious and cruel as their more powerful brethren. They happily vent their frustrations on anything weaker than themselves.</p>\n<p>Born from the souls of the slothful, these demons appear vaguely humanoid in appearance with awkward limbs and slack lumps of skin hanging from their frames. Supposedly, a single slothful soul of sufficient depravity and strength can spawn an entire horde of these creatures. However, as weaker demons, their lot in life is to suffer at the hands of more powerful Abyssal predators, and only a tiny number of dretches ever manage to become something more. For this reason, dretches are quite accommodating when summoned by mortals. They're usually content to work under conditions few other outsiders would accept, although they'll still gladly turn on even the kindest of masters who show even the slightest hint of weakness.</p>\n<hr />\n<p>Mortal souls that have been twisted and corrupted by sin sometimes arise in the afterlife as demons. These powerful and destructive fiends seek to spread their particular sin to warp more souls, thereby bolstering their numbers and continuing the cycle.</p>","publication":{"license":"OGL","remaster":false,"title":"Pathfinder Adventure: Rusthenge"}},"initiative":{"statistic":"perception"},"perception":{"details":"","mod":6,"senses":[{"type":"darkvision"}]},"resources":{"focus":{"max":1,"value":1}},"saves":{"fortitude":{"saveDetail":"","value":10},"reflex":{"saveDetail":"","value":4},"will":{"saveDetail":"","value":8}},"skills":{"acrobatics":{"base":6},"athletics":{"base":7},"deception":{"base":6},"stealth":{"base":6}},"spellcasting":{"rituals":{"dc":16}},"traits":{"rarity":"common","size":{"value":"sm"},"value":["chaotic","demon","evil","fiend","unholy"]},"_migration":{"version":0.959,"previous":null}},"type":"npc","effects":[]}]